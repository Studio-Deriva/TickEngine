{
	"schemaVersion": 1,
	"id": "tickengine",
	"version": "${version}",
	"name": "TickEngine",
	"description": "Server-side tick profiler and configurable throttling to run heavy modpacks on weak hardware.",
	"authors": ["Studio Deriva"],
	"contact": {
		"sources": "https://github.com/Studio-Deriva/TickEngine",
		"issues": "https://discord.gg/pQPWr7vfHu"
	},
	"license": "MIT",
	"icon": "assets/tickengine/icon.png",
	"environment": "server",
	"entrypoints": {
		"server": ["com.studioderiva.tickengine.TickEngine"]
	},
	"mixins": ["tickengine.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-permissions-api-v0": "*"
	}
}
